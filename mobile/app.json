{
  "expo": {
    "name": "School ERP",
    "slug": "school-erp-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#163B88",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.schoolerp.mobile"
    },
    "android": {
      "package": "com.schoolerp.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#163B88"
      }
    },
    "web": {
      "favicon": "./assets/icons/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-image-picker",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "f4180733-1200-49bd-b75a-0a65a7dd443d"
      }
    }
  }
}
